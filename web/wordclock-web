class Env:
    def __init__(self, root="", demo=False):
        self.demo = demo

        def p(path):
            return os.path.join(root, path.lstrip("/")) if root else path

        self.conf = p("/etc/wordclock/wordclock.conf")
        self.secret = p("/etc/wordclock/secret.conf")
        self.wpa = p("/etc/wpa_supplicant/wpa_supplicant.conf")
        self.run_dir = p("/run/wordclock")
        self.rtc = "/dev/rtc0"
        self.iface = read_kv(self.conf).get("wifi_interface", "wlan0")
        self._tz_cache = None

    def run(self, args, timeout=30):
        """Befehl ausführen -> (returncode, stdout). Im Demo-Modus simuliert."""
        if self.demo:
            return demo_run(self, args)
        try:
            r = subprocess.run(args, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                               universal_newlines=True, timeout=timeout)
            return r.returncode, r.stdout
        except (OSError, subprocess.TimeoutExpired) as e:
            return 1, str(e)

    def later(self, args, delay=2.0):
        """Befehl verzögert im Hintergrund ausführen (nach dem Senden der Antwort)."""
        def job():
            time.sleep(delay)
            self.run(args)
        threading.Thread(target=job, daemon=True).start()

    # --- Status ------------------------------------------------------------
    def wifi_state(self):
        try:
            with open(os.path.join(self.run_dir, "state")) as f:
                return f.read().strip() or "unknown"
        except OSError:
            return "unknown"

    def wifi_status(self):
        rc, out = self.run(["wpa_cli", "-i", self.iface, "status"])
        info = {}
        if rc == 0:
            for line in out.splitlines():
                if "=" in line:
                    k, v = line.split("=", 1)
                    info[k] = v
        return info

    def timedate(self):
        rc, out = self.run(["timedatectl", "show"])
        info = {}
        for line in out.splitlines():
            if "=" in line:
                k, v = line.split("=", 1)
                info[k] = v
        return info

    def timezones(self):
        if self._tz_cache is None:
            rc, out = self.run(["timedatectl", "list-timezones"])
            self._tz_cache = [z for z in out.split() if "/" in z or z == "UTC"] if rc == 0 else []
        return self._tz_cache

    def has_rtc(self):
        return self.demo or os.path.exists(self.rtc)


