def demo_run(env, args):
    cmd = " ".join(args)
    if args[:2] == ["timedatectl", "show"]:
        return 0, ("Timezone=Europe/Zurich\nNTP=yes\nNTPSynchronized=%s\n"
                   % ("yes" if env.wifi_state() == "client" else "no"))
    if args[:2] == ["timedatectl", "list-timezones"]:
        return 0, "UTC\nEurope/Berlin\nEurope/Vienna\nEurope/Zurich\nAmerica/New_York\n"
    if args[:1] == ["iw"] and "scan" in args:
        return 0, DEMO_SCAN
    if args[:1] == ["wpa_cli"]:
        if env.wifi_state() == "client":
            return 0, "wpa_state=COMPLETED\nssid=Zuhause\nip_address=192.168.1.42\n"
        return 1, ""
    sys.stderr.write("[demo] würde ausführen: %s\n" % cmd)
    return 0, ""


# ---------------------------------------------------------------------------
# Sitzungen
# ---------------------------------------------------------------------------
class Sessions:
    def __init__(self):
        self._s = {}
        self._lock = threading.Lock()

    def create(self):
        token = secrets.token_urlsafe(24)
        with self._lock:
            self._s[token] = time.time() + SESSION_HOURS * 3600
        return token

    def valid(self, token):
        if not token:
            return False
        with self._lock:
            exp = self._s.get(token)
            if exp and exp > time.time():
                return True
            self._s.pop(token, None)
        return False

    def drop(self, token):
        with self._lock:
            self._s.pop(token, None)


