# key=value-Dateien
# ---------------------------------------------------------------------------
def read_kv(path, strip_comments=True):
    values = {}
    try:
        with open(path, encoding="utf-8") as f:
            for line in f:
                line = line.rstrip("\n")
                if strip_comments:
                    line = re.sub(r"(^|\s)#.*$", "", line)
                if "=" not in line or line.lstrip().startswith("#"):
                    continue
                k, v = line.split("=", 1)
                values[k.strip()] = v.strip() if strip_comments else v.lstrip(" ")
    except OSError:
        pass
    return values


def write_atomic(path, text, mode):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".tmp-")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(text)
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def update_kv(path, updates, mode=0o644):
    """Einträge ändern, Kommentare und Reihenfolge der Datei bleiben erhalten."""
    try:
        with open(path, encoding="utf-8") as f:
            lines = f.read().splitlines()
    except OSError:
        lines = []
    done = set()
    out = []
    for line in lines:
        m = re.match(r"\s*([A-Za-z0-9_]+)\s*=", line)
        if m and m.group(1) in updates:
            key = m.group(1)
            if key in done:
                continue                     # doppelte Einträge entfernen
            out.append("%s = %s" % (key, updates[key]))
            done.add(key)
        else:
            out.append(line)
    for key, value in updates.items():
        if key not in done:
            out.append("%s = %s" % (key, value))
    write_atomic(path, "\n".join(out) + "\n", mode)


# ---------------------------------------------------------------------------
# wpa_supplicant.conf
# ---------------------------------------------------------------------------
WPA_HEADER = ("ctrl_interface=DIR=/var/run/wpa_supplicant GROUP=netdev\n"
              "update_config=1\n"
              "country=CH\n")


def _decode_ssid(value):
    value = value.strip()
    if len(value) >= 2 and value.startswith('"') and value.endswith('"'):
        return value[1:-1]
    try:
        return bytes.fromhex(value).decode("utf-8", "replace")
    except ValueError:
        return value


def read_wpa(path):
    """-> (Kopfteil, Liste von {'ssid', 'priority', 'text'})"""
    try:
        with open(path, encoding="utf-8") as f:
            text = f.read()
    except OSError:
        return WPA_HEADER, []
    networks = []
    header = []
    block = None
    for line in text.splitlines():
        if block is None:
            if re.match(r"\s*network\s*=\s*\{", line):
                block = [line]
            else:
                header.append(line)
        else:
            block.append(line)
            if line.strip() == "}":
                body = "\n".join(block)
                ssid = re.search(r"^\s*ssid\s*=\s*(.+)$", body, re.M)
                prio = re.search(r"^\s*priority\s*=\s*(-?\d+)", body, re.M)
                networks.append({"ssid": _decode_ssid(ssid.group(1)) if ssid else "",
                                 "priority": int(prio.group(1)) if prio else 0,
                                 "text": body})
                block = None
    head = "\n".join(header).strip()
    return (head + "\n" if head else WPA_HEADER), networks


def write_wpa(path, header, networks):
    text = header.rstrip("\n") + "\n"
    for n in networks:
        text += "\n" + n["text"].rstrip("\n") + "\n"
    write_atomic(path, text, 0o600)


def wpa_add(path, ssid, password):
    header, networks = read_wpa(path)
    networks = [n for n in networks if n["ssid"] != ssid]
    prio = max([n["priority"] for n in networks] + [0]) + 1
    lines = ["network={", "\tssid=%s" % ssid.encode("utf-8").hex()]
    if password:
        psk = hashlib.pbkdf2_hmac("sha1", password.encode("utf-8"),
                                  ssid.encode("utf-8"), 4096, 32).hex()
        lines += ["\tpsk=%s" % psk, "\tkey_mgmt=WPA-PSK"]
    else:
        lines.append("\tkey_mgmt=NONE")
    lines += ["\tpriority=%d" % prio, "\tid_str=\"wordclock\"", "}"]
    networks.append({"ssid": ssid, "priority": prio, "text": "\n".join(lines)})
    write_wpa(path, header, networks)


def wpa_remove(path, ssid):
    header, networks = read_wpa(path)
    remaining = [n for n in networks if n["ssid"] != ssid]
    if len(remaining) != len(networks):
        write_wpa(path, header, remaining)
        return True
    return False


# ---------------------------------------------------------------------------
# WLAN-Suche
# ---------------------------------------------------------------------------
_scan_cache = {"time": 0.0, "result": []}
_scan_lock = threading.Lock()


def _iw_unescape(s):
    raw = re.sub(r"\\x([0-9a-fA-F]{2})", lambda m: chr(int(m.group(1), 16)), s)
    try:
        return raw.encode("latin-1").decode("utf-8")
    except (UnicodeEncodeError, UnicodeDecodeError):
        return s


def parse_iw_scan(out):
    nets = {}
    cur = None
    for line in out.splitlines():
        if line.startswith("BSS "):
            cur = {"ssid": "", "signal": -100.0, "secure": False}
            nets.setdefault(id(cur), cur)
            continue
        if cur is None:
            continue
        s = line.strip()
        if s.startswith("signal:"):
            try:
                cur["signal"] = float(s.split()[1])
            except (IndexError, ValueError):
                pass
        elif s.startswith("SSID:"):
            cur["ssid"] = _iw_unescape(s[5:].strip())
        elif s.startswith("RSN:") or s.startswith("WPA:") or (
                s.startswith("capability:") and "Privacy" in s):
            cur["secure"] = True
    best = {}
    for n in nets.values():
        if n["ssid"] and (n["ssid"] not in best or n["signal"] > best[n["ssid"]]["signal"]):
            best[n["ssid"]] = n
    result = sorted(best.values(), key=lambda n: -n["signal"])
    for n in result:
        # dBm grob in 0..4 Balken umrechnen
        n["bars"] = max(0, min(4, int((n["signal"] + 95) / 10)))
    return result


def wifi_scan(env):
    with _scan_lock:
        if time.time() - _scan_cache["time"] < 15:
            return _scan_cache["result"]
        rc, out = env.run(["iw", "dev", env.iface, "scan"], timeout=20)
        if rc != 0:
            rc, out = env.run(["iw", "dev", env.iface, "scan", "ap-force"], timeout=20)
        result = parse_iw_scan(out) if rc == 0 else []
        _scan_cache.update(time=time.time(), result=result)
        return result


